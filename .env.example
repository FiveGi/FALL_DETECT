# Database (Postgres for Docker, MySQL for remote)
DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres
# DATABASE_URL=mysql+mysqlconnector://user:pass@host:3306/dbname?ssl_disabled=True

# Flask
SECRET_KEY=your-secret-key
PORT=8932
DEBUG=True
JWT_SECRET_KEY=your-jwt-secret

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CAMERA_MAX_PARALLEL=4
CELERY_WORKER_THREADS=2

# Detection
AI_CONFIDENCE_THRESHOLD=0.5

# Detection Model Paths
BED_EXIT_MODEL_PATH=models/bed_pose_mobilenetv2_3.onnx
FALL_DETECTION_MODEL_PATH=models/fall_detection_model.onnx

# Logging
LOGGING_INTERVAL=60
LOG_RETENTION_DAYS=30

# Notifications
ALERT_START_TIME=8:00
ALERT_END_TIME=20:00
NOTIFICATION_COOLDOWN=600

# LINE Messaging API push notifications (app/services/line_service.py)
# Master switch. Left false so a fresh clone never pushes to a real phone by accident.
LINE_ENABLED=false
# Channel access token from the LINE Developers console for your Messaging API channel.
LINE_CHANNEL_ACCESS_TOKEN=
# The LINE user id (or group id) to push alerts to.
LINE_USER_ID=
# Channel secret (LINE Developers console) -- verifies webhook callbacks.
LINE_CHANNEL_SECRET=
# Public HTTPS URL that reaches this backend from the internet, used to build alert-image links
# LINE can fetch (e.g. a cloudflared tunnel URL). Leave blank to send text-only alerts.
PUBLIC_BASE_URL=