# 127.0.0.1, not localhost: on Windows localhost resolves to ::1 first and Docker
# Desktop's WSL port relay binds IPv6 separately, so requests hang instead of
# failing fast when the relay sulks. Change the host if the API runs elsewhere.
VITE_API_BASE_URL=http://127.0.0.1:8932/api
VITE_APP_NAME=V89 Elderly Surveillance

# Firebase Configuration - แทนที่ค่าเหล่านี้ด้วยค่าจริงจาก Firebase Console
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
